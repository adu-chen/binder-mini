{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Binder Mini",
  "version": "0.1.0",
  "identifier": "com.binder.mini",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Binder Mini",
        "width": 1200,
        "height": 800,
        "devtools": true
      }
    ]
  },
  "bundle": {
    "active": false
  }
}
